# Copy to .env and adjust. Never commit .env.

APP_ENV=development

# PostgreSQL from docker-compose.yml (default):
DATABASE_URL=postgresql+psycopg://walang_pasok:walang_pasok@localhost:5432/walang_pasok
# No Docker? A local SQLite file works for trying things out:
# DATABASE_URL=sqlite:///./walang_pasok.db

# Required for POST /suspensions and PATCH /suspensions/{id}/verify.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me

# "Today" is computed in this timezone.
TIMEZONE=Asia/Manila

# Public address of the website, used for links in Discord and Facebook posts.
PUBLIC_BASE_URL=http://localhost:8000

# --- Facebook Page auto-posting (optional; leave blank to turn off) ---
# Every verified suspension is posted to your own Page. See README > Facebook.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v23.0
# Shown on the website as "Follow our Facebook Page".
FACEBOOK_PAGE_URL=

# Private Discord channel where the news watcher reports new pending suspensions.
ADMIN_DISCORD_WEBHOOK_URL=

# --- Hands-off mode ---
# The web app checks the news by itself every WATCH_INTERVAL_MINUTES and publishes
# finds that link to the LGU's own post or that 2+ outlets report; the rest wait for
# a person (listed in ADMIN_DISCORD_WEBHOOK_URL). Set WATCHER_ENABLED=false where
# GitHub Actions already runs it against the same database.
WATCHER_ENABLED=true
WATCH_INTERVAL_MINUTES=15
AUTO_PUBLISH=true
